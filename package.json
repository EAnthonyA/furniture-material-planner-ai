  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
