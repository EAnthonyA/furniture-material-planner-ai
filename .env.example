# PostgreSQL connection used by both the web app and worker.
DATABASE_URL="postgresql://planner:planner@localhost:5432/furniture_planner?schema=public"

# Private filesystem storage for local development.
STORAGE_ROOT="./uploads"

# Local single-owner bootstrap; authentication will replace this in a later slice.
OWNER_EMAIL="owner@local.invalid"

# Configure after the Gemini evaluation milestone. Never expose this value in NEXT_PUBLIC_*.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
